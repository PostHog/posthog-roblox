{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"moduleResolution": "Node",
		"lib": ["ESNext"],
		"typeRoots": ["node_modules/@rbxts"],
		"strict": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["bindings/**/*.d.ts"]
}
